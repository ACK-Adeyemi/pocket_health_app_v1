rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Simple helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    function isModerator() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data != null && 
             (userDoc.data.role == 'moderator' || userDoc.data.role == 'admin');
    }
    
    function isAdmin() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data != null && userDoc.data.role == 'admin';
    }
    
    // Users collection
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isModerator();
      allow read: if isAuthenticated(); // Allow reading other users for community features
    }
    
    // Groups collection
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow update: if isModerator();
    }
    
    // Threads collection
    match /threads/{threadId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() && 
                   request.auth.uid == request.resource.data.authorId &&
                   exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId));
      
      allow update: if isOwner(resource.data.authorId) || isModerator() ||
                   (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'dislikeCount', 'commentCount', 'lastActivityAt', 'updatedAt']));
      
      allow delete: if isModerator();
    }
    
    // Comments collection
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() && 
                   request.auth.uid == request.resource.data.authorId &&
                   exists(/databases/$(database)/documents/threads/$(request.resource.data.threadId));
      
      allow update: if isOwner(resource.data.authorId) || isModerator() ||
                   (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'dislikeCount', 'updatedAt']));
      
      allow delete: if isModerator();
    }
    
    // Reports collection
    match /reports/{reportId} {
      allow read: if isModerator();
      allow create: if isAuthenticated() && 
                   request.auth.uid == request.resource.data.reporterId;
      allow update: if isModerator();
      allow delete: if isAdmin();
    }
    
    // Votes subcollection
    match /{document=**}/votes/{voteId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && 
                           request.auth.uid == request.resource.data.userId;
      allow delete: if isAuthenticated() && 
                   resource.data.userId == request.auth.uid;
    }
    
    // Health entries collection
    match /health_entries/{entryId} {
      allow read: if isOwner(resource.data.userId) || isModerator();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isModerator();
    }
    
    // Health conditions collection
    match /health_conditions/{conditionId} {
      allow read: if isOwner(resource.data.userId) || isModerator();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isModerator();
    }
    
    // GP details collection
    match /gp_details/{gpId} {
      allow read: if isOwner(resource.data.userId) || isModerator();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }
    
    // Moderation actions collection
    match /moderation_actions/{actionId} {
      allow read, write: if isModerator();
    }
    
    // System settings (admin only)
    match /system_settings/{settingId} {
      allow read, write: if isAdmin();
    }
    
    // Audit logs (admin only)
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
